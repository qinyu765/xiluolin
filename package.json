{
  "name": "xiluolin",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,json,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "bindings:generate": "node scripts/bindings.mjs",
    "bindings:check": "node scripts/bindings.mjs --check",
    "release:check": "node scripts/release-check.mjs",
    "build:frontend": "node scripts/build.mjs",
    "build": "pnpm typecheck && pnpm build:frontend",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo check --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm check:frontend && pnpm bindings:check && pnpm check:rust",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:macos:arm64": "MACOSX_DEPLOYMENT_TARGET=13.0 CMAKE_OSX_DEPLOYMENT_TARGET=13.0 pnpm tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "tauri:build:windows:x64": "pnpm tauri build --target x86_64-pc-windows-msvc --bundles nsis"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.1",
      "postcss": "8.5.25",
      "undici": "7.29.0"
    }
  },
  "packageManager": "pnpm@10.26.2",
  "description": "开源 AI 语音输入助手，将语音转化为可直接使用的办公、写作和编程文本。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinyu765/xiluolin.git"
  },
  "bugs": {
    "url": "https://github.com/qinyu765/xiluolin/issues"
  },
  "homepage": "https://github.com/qinyu765/xiluolin#readme"
}
